EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Largo del código de verificación de correo. Debe coincidir con
# Authentication -> Providers -> Email -> "Email OTP Length" en Supabase.
# Ausente = 6. Supabase admite de 6 a 10.
#
# HOY EL PROYECTO ESTÁ EN 8. Dejarlo en 6 —o no definirlo— no da ningún error
# visible: el campo recorta el código a 6 dígitos, nunca coincide con el que
# llegó por correo, y el registro se queda bloqueado sin decir por qué.
EXPO_PUBLIC_OTP_LENGTH=8
